# Copy this file to `.env` and fill in your keys.

# Required: NewsAPI key (https://newsapi.org). Free tier is fine.
NEWSAPI_KEY=

# Optional: override the Claude model used (defaults to claude-opus-4-7).
# Examples: claude-opus-4-7, claude-opus-4-5, claude-sonnet-4-6
# Use any model alias your Claude Code CLI accepts (`claude --help`).
CLAUDE_MODEL=claude-opus-4-7

# Optional: absolute path to the `claude` CLI executable.
# Leave empty to use whatever is on your PATH.
CLAUDE_CLI_PATH=
